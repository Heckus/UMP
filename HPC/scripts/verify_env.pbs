#!/bin/bash -l
#PBS -N ump_verify_env
#PBS -l select=1:ncpus=42:ngpus=1:mem=243gb:gpu_id=H100
#PBS -l walltime=00:30:00
#PBS -P EUAPGM7346
#PBS -j oe
#PBS -o verify_env_complete.log

# ==============================================================================
# verify_env.pbs - HPC wrapper for system diagnostics
#
# Ensures the HPC environment has GPUs available, Conda initialized,
# all 11 environments built and functionally verified with PyTorch CUDA probes.
# ==============================================================================

cd $PBS_O_WORKDIR

# In PBS Pro on Aqua, standard PBS output (-o) is spooled until job completion.
# To allow real-time monitoring (tail -f) during execution, stream output
# concurrently to verify_env_live.log in the working directory.
LIVE_LOG="$PBS_O_WORKDIR/verify_env_live.log"
exec > >(tee "${LIVE_LOG}") 2>&1
export PYTHONUNBUFFERED=1

echo "Loading Anaconda3 and CUDA modules..."
module load Anaconda3/2024.02-1

# Try loading CUDA module - attempt multiple versions as availability varies by node
for CUDA_VER in "CUDA/12.1.1" "CUDA/12.4.0" "CUDA/11.8.0" "CUDA/12.6.0"; do
    if module load "${CUDA_VER}" 2>/dev/null; then
        echo "Loaded ${CUDA_VER}"
        break
    fi
done

# Force CUDA_HOME for PyTorch cpp_extension compilation
if command -v nvcc >/dev/null 2>&1; then
    export CUDA_HOME=$(dirname $(dirname $(command -v nvcc)))
    echo "CUDA_HOME set to: ${CUDA_HOME}"
else
    for CUDA_PATH in /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.1.1 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.4.0 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/11.8.0 \
                     /usr/local/cuda; do
        if [[ -f "${CUDA_PATH}/bin/nvcc" ]]; then
            export CUDA_HOME="${CUDA_PATH}"
            export PATH="${CUDA_HOME}/bin:${PATH}"
            echo "CUDA_HOME set via fallback: ${CUDA_HOME}"
            break
        fi
    done
fi

# Initialize Conda
eval "$(conda shell.bash hook)"

# Append the global_tools bin directory to the END of PATH so we don't override python/pip
export PATH="$PATH:$HOME/.conda/envs/global_tools/bin"

# Path to the core automation script
if [ -f "Codebase/scripts/verify_env.sh" ]; then
    VERIFY_SCRIPT="$PBS_O_WORKDIR/Codebase/scripts/verify_env.sh"
elif [ -f "../../Codebase/scripts/verify_env.sh" ]; then
    VERIFY_SCRIPT="$PBS_O_WORKDIR/../../Codebase/scripts/verify_env.sh"
else
    echo "Error: Could not locate Codebase/scripts/verify_env.sh from $PBS_O_WORKDIR"
    exit 1
fi

echo "Running Comprehensive Pre-Flight Diagnostics..."

# Run full beefed-up verification suite:
#   --all-envs: Verify all 11 Conda environments
#   --check-gpu: Verify NVIDIA GPU, driver, VRAM, and compute capability
#   --check-tools: Verify system binaries (colmap, ffmpeg, git, python3)
#   --deep: Execute in-environment Python/PyTorch CUDA tensor probes and C++ extension imports
#   --system: Audit node CPU, RAM, and disk storage
#   --check-submodules: Validate presence and non-emptiness of required git submodules
if bash "$VERIFY_SCRIPT" --all-envs --check-gpu --check-tools --deep --system --check-submodules; then
    echo "======================================================================"
    echo " All Pre-Flight Diagnostics Passed! Ready for run_pipeline.pbs."
    echo "======================================================================"
    exit 0
else
    V_EXIT=$?
    echo "======================================================================"
    echo " Diagnostics FAILED with Exit Code: ${V_EXIT}."
    echo " Please resolve errors shown above before submitting run_pipeline.pbs."
    echo "======================================================================"
    exit ${V_EXIT}
fi
