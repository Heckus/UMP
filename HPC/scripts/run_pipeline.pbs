#!/bin/bash -l
#PBS -N ump_run_pipeline
#PBS -l select=1:ncpus=42:ngpus=1:mem=243gb:gpu_id=H100
#PBS -l walltime=48:00:00
#PBS -P EUAPGM7346
#PBS -j oe
#PBS -o run_pipeline_complete.log

# ==============================================================================
# run_pipeline.pbs - HPC wrapper for training and evaluation orchestration
#
# This script configures the node with Anaconda and launches the main
# run_pipeline.sh automation suite.
# ==============================================================================

cd $PBS_O_WORKDIR

# In PBS Pro on Aqua, standard PBS output (-o) is spooled until job completion.
# To allow real-time monitoring (tail -f) during execution, stream output
# concurrently to run_pipeline_live.log in the working directory.
LIVE_LOG="$PBS_O_WORKDIR/run_pipeline_live.log"
exec > >(tee "${LIVE_LOG}") 2>&1
export PYTHONUNBUFFERED=1

echo "Loading Anaconda3 and CUDA modules..."
module load Anaconda3/2024.02-1

# Try loading CUDA module - attempt multiple versions as availability varies by node
for CUDA_VER in "CUDA/12.1.1" "CUDA/12.4.0" "CUDA/11.8.0" "CUDA/12.6.0"; do
    if module load "${CUDA_VER}" 2>/dev/null; then
        echo "Loaded ${CUDA_VER}"
        break
    fi
done

# Force CUDA_HOME for PyTorch cpp_extension compilation
if command -v nvcc >/dev/null 2>&1; then
    export CUDA_HOME=$(dirname $(dirname $(command -v nvcc)))
    echo "CUDA_HOME set to: ${CUDA_HOME}"
else
    for CUDA_PATH in /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.1.1 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.4.0 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/11.8.0 \
                     /usr/local/cuda; do
        if [[ -f "${CUDA_PATH}/bin/nvcc" ]]; then
            export CUDA_HOME="${CUDA_PATH}"
            export PATH="${CUDA_HOME}/bin:${PATH}"
            echo "CUDA_HOME set via fallback: ${CUDA_HOME}"
            break
        fi
    done
fi

# Initialize Conda
eval "$(conda shell.bash hook)"

# Detect Conda executable and installation root
if command -v conda >/dev/null 2>&1; then
    export CONDA_EXE="$(command -v conda)"
    export CONDA_DIR="$(dirname $(dirname "${CONDA_EXE}"))"
    echo "CONDA_DIR set to: ${CONDA_DIR}"
fi

# Prevent WandB from hanging on headless batch jobs waiting for interactive login
export WANDB_MODE="${WANDB_MODE:-offline}"

# Hopper H100 architecture target for PyTorch JIT compilation
export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-8.0;8.6;8.9;9.0+PTX}"

# Append the global_tools bin directory to the END of PATH so we don't override python/pip
export PATH="$PATH:$HOME/.conda/envs/global_tools/bin"

# Path to the core automation script
# Robust path resolution to handle execution from repository root or HPC/scripts/
if [ -f "Codebase/scripts/run_pipeline.sh" ]; then
    PIPELINE_SCRIPT="$PBS_O_WORKDIR/Codebase/scripts/run_pipeline.sh"
elif [ -f "../../Codebase/scripts/run_pipeline.sh" ]; then
    PIPELINE_SCRIPT="$PBS_O_WORKDIR/../../Codebase/scripts/run_pipeline.sh"
else
    echo "Error: Could not locate Codebase/scripts/run_pipeline.sh from $PBS_O_WORKDIR"
    exit 1
fi

echo "Executing Pipeline Automation Suite..."

# By default this runs all models.
# To override, you can specify arguments when submitting:
# qsub -v ARGS="--model seasplat --scene Cormoran" run_pipeline.pbs
# Or modify the command below directly.

if [ -n "$ARGS" ]; then
    bash "$PIPELINE_SCRIPT" $ARGS
else
    bash "$PIPELINE_SCRIPT" --all
fi
PIPE_EXIT=$?

if [ ${PIPE_EXIT} -eq 0 ]; then
    echo "======================================================================"
    echo " Pipeline Automation Suite Completed Successfully!"
    echo "======================================================================"
else
    echo "======================================================================"
    echo " Pipeline Automation Suite Terminated with Errors (Exit Code: ${PIPE_EXIT})"
    echo " Check pipeline_errors.log and run_pipeline_complete.log for details."
    echo "======================================================================"
fi

exit ${PIPE_EXIT}
