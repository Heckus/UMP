#!/bin/bash -l
#PBS -N ump_setup_env
#PBS -l select=1:ncpus=42:ngpus=1:mem=243gb:gpu_id=H100
#PBS -l walltime=02:00:00
#PBS -P EUAPGM7346
#PBS -j oe
#PBS -o setup_env_complete.log

# ==============================================================================
# setup_env.pbs - HPC wrapper for environment provisioning
#
# Provisions Conda environments using the HPC Anaconda module and the
# underlying setup_env.sh automation script.
# Configured for QUT Aqua cluster H100 GPU nodes with optimal resource shares.
# ==============================================================================

cd $PBS_O_WORKDIR

# In PBS Pro on Aqua, standard PBS output (-o) is spooled until job completion.
# To allow real-time monitoring (tail -f) during execution, stream output
# concurrently to setup_env_live.log in the working directory.
LIVE_LOG="$PBS_O_WORKDIR/setup_env_live.log"
exec > >(tee "${LIVE_LOG}") 2>&1
export PYTHONUNBUFFERED=1

echo "Loading Anaconda3 and CUDA modules..."
module load Anaconda3/2024.02-1

# Try loading CUDA module - attempt multiple version strings as availability varies by node
for CUDA_VER in "CUDA/12.1.1" "CUDA/12.4.0" "CUDA/11.8.0" "CUDA/12.6.0"; do
    if module load "${CUDA_VER}" 2>/dev/null; then
        echo "Loaded ${CUDA_VER}"
        break
    fi
done

# Force CUDA_HOME export for PyTorch cpp_extension compilation
# Try nvcc from loaded module first, then common system paths
if command -v nvcc >/dev/null 2>&1; then
    export CUDA_HOME=$(dirname $(dirname $(command -v nvcc)))
    echo "CUDA_HOME set to: ${CUDA_HOME}"
else
    # Fallback: scan known HPC paths
    for CUDA_PATH in /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.1.1 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/12.4.0 \
                     /mnt/weka/pkg/rhel94/AuthenticAMD-25/software/CUDA/11.8.0 \
                     /usr/local/cuda; do
        if [[ -f "${CUDA_PATH}/bin/nvcc" ]]; then
            export CUDA_HOME="${CUDA_PATH}"
            export PATH="${CUDA_HOME}/bin:${PATH}"
            echo "CUDA_HOME set via fallback path: ${CUDA_HOME}"
            break
        fi
    done
fi

# Initialize Conda for the current shell context safely
eval "$(conda shell.bash hook)"

# Provision global system tools (colmap, ffmpeg, openimageio) securely via Conda if missing
if ! conda env list 2>/dev/null | grep -E '^[[:space:]]*global_tools[[:space:]]' >/dev/null 2>&1; then
    echo "Provisioning global system tools (colmap, ffmpeg, openimageio) via Conda..."
    conda create -n global_tools -c conda-forge colmap ffmpeg openimageio -y
else
    echo "Conda environment 'global_tools' is already present. Ensuring openimageio is installed..."
    conda install -n global_tools -c conda-forge openimageio -y
fi

# Append the global_tools bin directory to PATH for system tool access.
# NOTE: Do NOT export global_tools/lib into LD_LIBRARY_PATH as it leaks
# conda-forge C++/Qt libraries into target environments and breaks C extensions.
export PATH="$PATH:$HOME/.conda/envs/global_tools/bin"

# Path to the core automation script
if [ -f "Codebase/scripts/setup_env.sh" ]; then
    SETUP_SCRIPT="$PBS_O_WORKDIR/Codebase/scripts/setup_env.sh"
elif [ -f "../../Codebase/scripts/setup_env.sh" ]; then
    SETUP_SCRIPT="$PBS_O_WORKDIR/../../Codebase/scripts/setup_env.sh"
else
    echo "Error: Could not locate Codebase/scripts/setup_env.sh from $PBS_O_WORKDIR"
    exit 1
fi

echo "Provisioning Environments..."

FAILED_ENVS=()

# Provision each environment independently to bypass system dependency checks.
# Healthy existing environments are verified and reused quickly;
# water_splatting will complete its pending package installation.
for ENV_NAME in colmap_runner depth_anything seasplat_py310 3d-uir gaussianSplashing_env water_splatting rusplatting UW-GS sugar oscd 3dgs; do
    echo "======================================================================"
    echo " Provisioning Conda Environment: ${ENV_NAME}"
    echo "======================================================================"
    if ! bash "${SETUP_SCRIPT}" -y --env "${ENV_NAME}"; then
        echo "ERROR: Failed to provision ${ENV_NAME}" >&2
        FAILED_ENVS+=("${ENV_NAME}")
    fi
done

if [ ${#FAILED_ENVS[@]} -ne 0 ]; then
    echo "======================================================================"
    echo " SETUP FAILED: The following environment(s) failed to provision:"
    for F_ENV in "${FAILED_ENVS[@]}"; do
        echo "  - ${F_ENV}"
    done
    echo "======================================================================"
    exit 1
fi

echo "======================================================================"
echo " All Environments Setup Complete and Verified!"
echo "======================================================================"
