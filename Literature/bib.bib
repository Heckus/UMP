@inproceedings{10.1145/3806262.3806264,
author = {Zhong, Qianwen and Liu, Wenhui and Zhou, Hongping and Lu, Ping and Shi, Wenzhe},
title = {3D Gaussian Splatting for Scene Editing and Completion},
year = {2026},
isbn = {9798400723407},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806262.3806264},
doi = {10.1145/3806262.3806264},
abstract = {In recent years, 3D Gaussian Splatting (3DGS) has rapidly emerged as a research hotspot for next-generation 3D scene modeling and reconstruction, owing to its highly efficient differentiable representation and superior rendering performance. Building upon this foundation, 3DGS-based scene editing techniques have attracted increasing attention, offering flexible and high-quality solutions for tasks such as object insertion, deletion, deformation, and completion. This paper provides a comprehensive review of the latest research progress in 3D scene editing based on 3DGS. We first revisit the development background of 3DGS and then categorize existing editing methods from two perspectives: editing scenarios and control mechanisms. The survey covers four major categories, namely static scene editing, dynamic scene editing, semantic-driven editing, and user-interactive editing, while also summarizing mainstream scene completion approaches. Finally, we discuss the current challenges faced by this field and outline future research directions in semantic fusion, multimodal generation, and editing evaluation, aiming to provide systematic insights and references for researchers in related domains.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Digital Media Technology and Social Computing},
pages = {14–25},
numpages = {12},
keywords = {3D Gaussian Splatting, 3D Scene Editing, Scene Completion},
location = {
},
series = {ICAIDS '26}
}

