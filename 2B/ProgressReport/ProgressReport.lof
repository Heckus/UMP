\contentsline {figure}{\numberline {3.1}{\ignorespaces The end-to-end 6-stage automated pipeline executed across all benchmark targets on the QUT Aqua HPC cluster.}}{12}{figure.caption.19}%
\addvspace {10pt}
\contentsline {figure}{\numberline {4.1}{\ignorespaces Novel view 3D Gaussian Splatting reconstructions using SeaSplat on (a) Kwajalein and (b) Tokai Maru. The physically grounded optical model decouples water column backscatter and wavelength attenuation, recovering true benthic albedo and sharp structural edges.}}{20}{figure.caption.22}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Close-up volumetric novel view renders of 3D-UIR on (a) Kwajalein and (b) Tokai Maru. Depth-scaled restoration regularization enables 3D-UIR to resolve millimetre-scale geometric details on complex marine surfaces without over-smoothing.}}{20}{figure.caption.23}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Visual comparison of restoration-guided 3DGS models on Kwajalein: (a) Gaussian Splashing excels in smooth volumetric medium transitions, while (b) WaterSplatting provides sharp, high-contrast perceptual boundaries.}}{21}{figure.caption.24}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Comparison of supplementary underwater 3DGS architectures on Kwajalein: (a) RUSplatting with inverted depth supervision and (b) UW-GS with distractor-aware variance filtering.}}{21}{figure.caption.25}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Watertight surface meshes extracted via SuGaR on (a) Kwajalein and (b) Tokai Maru. Enforcing an SDF prior eliminates unanchored floaters from the water column, yielding clean physical geometry suitable for structural change analysis.}}{23}{figure.caption.27}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Post-change 3D reconstruction on the Custom OSCD dataset: (a) updated 3D Gaussian Splatting model after primitive-space update ($PSNR = 27.08\text { dB}$, $SSIM = 0.8315$) and (b) corresponding watertight SuGaR surface mesh.}}{24}{figure.caption.28}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Volumetric 3D change heatmaps generated in primitive space by O-SCD: (a) updated scene highlighting relocated objects in Google Turbo false colour, and (b) unified bidirectional change splat retaining the volumetric thermal ``ghost'' of the removed soda can from $T_0$.}}{24}{figure.caption.29}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Synchronized multi-view change detection sequence from O-SCD across six camera perspectives (frames 001, 025, 049, 073, 097, and 122). Columns from left to right: (1) Reference RGB capture at $T_0$ showing the red soda can, pencil case, marker, highlighter, and ruler; (2) Query inspection capture at $T_1$ after object removal and rearrangement; (3) Spatial thermal change heatmap overlay; and (4) Extracted binary change segmentation mask.}}{25}{figure.caption.30}%
